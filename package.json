{
  "name": "overlock-monorepo",
  "private": true,
  "description": "Monorepo for overlock, a deterministic gate on test integrity in a git patch.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/overlock.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test //#test:scripts",
    "typecheck": "turbo run typecheck //#typecheck:scripts",
    "lint": "turbo run eslint:check",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "eslint:check": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "turbo run prettier:check",
    "prettier:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "knip:check": "knip",
    "sherif:check": "sherif --fail-on-warnings",
    "check:exports": "turbo run check:exports --filter=overlock",
    "pack:smoke": "turbo run pack:smoke --concurrency=1 --filter=overlock",
    "check:llms": "rxova-repo-config check-llms",
    "docs": "pnpm --filter @overlock/docs dev",
    "docs:build": "pnpm --filter @overlock/docs build",
    "e2e": "turbo run build --filter=overlock && pnpm --filter overlock run e2e",
    "verify": "rxova-repo-config verify",
    "release": "turbo run build --filter=overlock && changeset publish",
    "prepare": "husky",
    "test:scripts": "vitest run --coverage",
    "typecheck:scripts": "tsc -p tsconfig.json"
  },
  "repoConfig": {
    "verify": {
      "steps": [
        {
          "name": "lint",
          "command": "pnpm lint"
        },
        {
          "name": "format",
          "command": "pnpm format:check"
        },
        {
          "name": "build",
          "command": "pnpm exec turbo run build --filter='!@overlock/docs'"
        },
        {
          "name": "typecheck",
          "command": "pnpm exec turbo run typecheck //#typecheck:scripts"
        },
        {
          "name": "unit tests",
          "command": "pnpm exec turbo run test //#test:scripts"
        },
        {
          "name": "package exports",
          "command": "pnpm run check:exports"
        },
        {
          "name": "llms.txt",
          "command": "pnpm run check:llms"
        },
        {
          "name": "dependency versions",
          "command": "pnpm run sherif:check"
        },
        {
          "name": "unused files, exports and dependencies",
          "command": "pnpm run knip:check"
        },
        {
          "name": "audit",
          "command": "pnpm run audit:check"
        },
        {
          "name": "dependency dedupe",
          "command": "pnpm run dedupe:check"
        }
      ]
    },
    "llms": {
      "sections": [
        "Commands",
        "Links"
      ]
    },
    "postPublish": {
      "registryTimeoutMinutes": 45
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@rxova/docs-kit": "^0.1.1",
    "@rxova/repo-config": "^0.6.0",
    "@rxova/ts-utils": "^0.2.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "sherif": "^1.13.0",
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
