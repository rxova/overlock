{
  "name": "overlock",
  "version": "0.10.2",
  "description": "Deterministic, zero-dependency gate on test integrity in a git patch: reports skipped tests, removed or weakened assertions, and lowered coverage thresholds.",
  "license": "MIT",
  "author": "Jonatan Kruszewski <jonakrusze@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/overlock.git",
    "directory": "packages/overlock"
  },
  "homepage": "https://github.com/rxova/overlock#readme",
  "bugs": "https://github.com/rxova/overlock/issues",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "hooks",
    "code-review",
    "diff",
    "git",
    "test-integrity",
    "reward-hacking",
    "guardrails",
    "lint"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "overlock": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "assets/logo.svg",
    "dist",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --coverage",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "check:exports": "rxova-repo-config check-exports",
    "pack:smoke": "rxova-repo-config pack-smoke"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.21",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "repoConfig": {
    "exports": {
      "profile": "esm-only"
    },
    "llms": {
      "api": "none",
      "idsFrom": "packages/overlock/src/types.ts#RULE_IDS",
      "idPattern": "\\b[A-Z][A-Z_]{6,}\\b",
      "requiredTerms": [
        "overlock check",
        "overlock hook claude",
        "overlock init",
        "overlock report",
        "overlock mcp",
        "overlock config",
        "overlock evaluate",
        "overlock replay",
        "overlock import"
      ]
    }
  }
}
